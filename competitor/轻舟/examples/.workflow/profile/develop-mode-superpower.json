{
  "desc": "基于superpower底层驱动的研发核心流程：头脑风暴规划 + 代码评审，不含部署/转测/端到端自动化测试。对比 standard-superpower 去除了部署、转测与端到端自动化测试，流程更短。代码提交由开发者自行完成（archive 收尾会兜底提交）。",
  "enabled": false,
  "has_e2etest": false,
  "start_node": "workflow-brainstorming",
  "roles": {
    "spec": "docs/superpowers/specs/<task>.md",
    "trd": "docs/superpowers/plans/<task>.md",
    "schema-draft": "delivery/<task>/schema/"
  },
  "nodes": [
    {
      "node": "workflow-superpower-plan",
      "exit_gate": "confirm-locked"
    },
    {
      "node": "workflow-implement",
      "exit_gate": "auto",
      "autopilot": true
    },
    {
      "node": "workflow-lint",
      "exit_gate": "auto",
      "autopilot": true
    },
    {
      "node": "workflow-code-review",
      "exit_gate": "auto",
      "autopilot": true,
      "execution": "subagent",
      "feedback": {
        "can_report": true,
        "reroute_options": [
          "workflow-implement"
        ]
      }
    },
    {
      "node": "workflow-archive",
      "entry_gate": "confirm-locked",
      "exit_gate": "confirm-locked",
      "feedback": {
        "rerouteable": false
      }
    }
  ]
}
